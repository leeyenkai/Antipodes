<?xml version="1.0" encoding="UTF-8"?>
<!--
  iCloud entitlements for private CloudKit sync (R-PRIV-2).

  NOT wired into the build settings yet, deliberately. A CloudKit entitlement needs a
  provisioning profile and a container that exists in a developer account, so wiring it
  in would stop this project building for anyone who has not set that up.

  To enable sync: open the project in Xcode → the Antipodes target → Signing &
  Capabilities → set your team, add the iCloud capability, tick CloudKit and select or
  create the container below. Xcode will set CODE_SIGN_ENTITLEMENTS for you.

  Until then `TravelLogStore` opens with `cloudKitDatabase: .automatic`, which runs
  local-only without an entitlement. Nothing else about the app changes.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.example.antipodes</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
