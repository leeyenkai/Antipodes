<?xml version="1.0" encoding="UTF-8"?>
<!--
  The iPhone and iPad app's entitlements: the app group it shares with the widget
  extension, which reads the snapshot the app writes (R-SHARE-2).

  The simulator honours this without a team. A device build needs a team set in
  Signing & Capabilities; with automatic signing Xcode then registers the group.
  There is deliberately no iCloud entitlement: the log stays on the device (D-31).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.leeyenkai.antipodes</string>
	</array>
</dict>
</plist>
