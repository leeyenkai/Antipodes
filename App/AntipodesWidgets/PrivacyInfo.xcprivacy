<?xml version="1.0" encoding="UTF-8"?>
<!--
  The widget extension's privacy manifest. It collects nothing and tracks no one, like
  the app (R-PRIV-1). It reads only the snapshot the app leaves in their shared app
  group, and uses no required-reason API.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
